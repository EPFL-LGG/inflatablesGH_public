Notebook[{
Cell["\<\
Huber approximation from \
https://www.maths.ed.ac.uk/~prichtar/Optimization_and_Big_Data/slides/Gondzio.\
pdf\
\>", "Text",
 CellChangeTimes->{{3.763374382667762*^9, 
  3.763374402175645*^9}},ExpressionUUID->"01c0e949-294a-467f-80cc-\
c16b2802a9e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Huber", "[", 
   RowBox[{"x_", ",", " ", "\[Mu]_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", "x", "]"}], "\[LessEqual]", "\[Mu]"}], ",", " ", 
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox[
      SuperscriptBox["x", "2"], "\[Mu]"]}], ",", 
    RowBox[{
     RowBox[{"Abs", "[", "x", "]"}], " ", "-", " ", 
     RowBox[{
      FractionBox["1", "2"], "\[Mu]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7633746813070793`*^9, 3.7633747477360697`*^9}, {
  3.7633748082975082`*^9, 
  3.7633748473504972`*^9}},ExpressionUUID->"b0e95b76-52d8-4a20-ae0d-\
c5df4450a1e0"],

Cell["Pseudo Huber approximation", "Text",
 CellChangeTimes->{{3.763374390322406*^9, 
  3.763374395004644*^9}},ExpressionUUID->"23280848-e3ba-4ddb-9fc3-\
d8399aa789d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PseudoHuber", "[", 
   RowBox[{"x_", ",", " ", "\[Mu]_"}], "]"}], ":=", 
  RowBox[{"\[Mu]", " ", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", " ", "+", " ", 
       FractionBox[
        SuperscriptBox["x", "2"], 
        SuperscriptBox["\[Mu]", "2"]]}]], "-", "1"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.763374410453705*^9, 
  3.763374469126194*^9}},ExpressionUUID->"a2690e47-fefc-419b-b8ad-\
e5a13b0734af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Huber", "[", 
        RowBox[{"x", ",", "\[Mu]"}], "]"}], ",", " ", 
       RowBox[{"PseudoHuber", "[", 
        RowBox[{"x", ",", " ", "\[Mu]"}], "]"}], ",", " ", 
       SuperscriptBox["x", "2"], ",", 
       RowBox[{"Abs", "[", "x", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", " ", "0.5"}], "}"}], ",", " ", "0", ",", " ", 
     "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7633744719536858`*^9, 3.76337450593034*^9}, {
  3.763374538087853*^9, 3.763374575822473*^9}, {3.763374609227817*^9, 
  3.7633746114389143`*^9}, {3.763374756474061*^9, 
  3.763374763096096*^9}},ExpressionUUID->"7992c51d-ee41-4a4a-aa5b-\
75c108f0309e"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`\[Mu]$$ = 0.152, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
