         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", "-", " ", 
          RowBox[{"Sin", "[", "\[Beta]", "]"}]}], ")"}], "2"]}]], ",", " ", 
     RowBox[{"{", 
