Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", "-", " ", 
          RowBox[{"Cos", "[", "\[Beta]", "]"}]}], ")"}], "2"], "+", 
