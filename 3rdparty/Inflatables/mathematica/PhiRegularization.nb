Cell["\<\
Plot of regularization term and its first two derivatives for a particular p \
between 1 and 2. The second derivatives for the well-behaved p=1 and p=2 \
cases are also plotted.\
\>", "Text",
 CellChangeTimes->{{3.762866590241158*^9, 
  3.762866665671628*^9}},ExpressionUUID->"2d814e78-3eb9-49e0-ad90-\
4eeca28b092c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", "=", "1.0001"}], "}"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "p"], 
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], "p"]}], ",", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}]], " ", 
        RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
        RowBox[{"Sign", "[", "\[Alpha]", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", "-", "1"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], 
          RowBox[{
           RowBox[{"-", "2"}], "+", "p"}]], " ", 
         SuperscriptBox[
          RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], 
          RowBox[{
           RowBox[{"-", "1"}], "+", "p"}]], " ", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
         RowBox[{"Sign", "[", "\[Alpha]", "]"}]}]}], ",", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Alpha]"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Abs", "[", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", 
       RowBox[{"-", 
        FractionBox["\[Pi]", "4"]}], ",", 
       FractionBox["\[Pi]", "4"]}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.762863492116981*^9, 3.762863557086113*^9}, {
   3.762863649814402*^9, 3.7628636503590317`*^9}, {3.762863695074502*^9, 
