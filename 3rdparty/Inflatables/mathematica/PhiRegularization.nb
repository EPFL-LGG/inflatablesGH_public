Cell["\<\
For all 1<p<2, the second derivative blows up at \[Alpha]=0. We investigate \
the behavior for \[Alpha] near zero over this range of p values.\
\>", "Text",
 CellChangeTimes->{{3.762866750194042*^9, 
  3.762866834720684*^9}},ExpressionUUID->"1655c482-28bd-4f13-9e29-\
0586cb45ad97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "4"}]]}], "}"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "-", "1"}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], 
        RowBox[{
         RowBox[{"-", "2"}], "+", "p"}]], " ", 
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], "]"}], 
        RowBox[{
         RowBox[{"-", "1"}], "+", "p"}]], " ", 
       RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
       RowBox[{"Sign", "[", "\[Alpha]", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.762866364606154*^9, 
  3.762866481977145*^9}},ExpressionUUID->"3eecfbeb-53d2-4887-be92-\
27e6f406901e"],

